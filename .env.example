# ============================================================
# OSS-Safeguard Policy Tester — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------

# Groq API Key — used to call gpt-oss-safeguard-20b for policy evaluation
# Get yours at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------
# OPTIONAL — Image Generation
# ------------------------------------------------------------

# Fal.ai API Key — used for cloud-based image generation
# Get yours at: https://fal.ai/dashboard/keys
# Leave empty to disable Fal.ai image generation
FAL_KEY=your_fal_api_key_here

# Stable Diffusion model ID (HuggingFace) for local image generation
# Defaults to segmind/tiny-sd (fast, ~151MB)
# Other options: runwayml/stable-diffusion-v1-5, stabilityai/stable-diffusion-2-1
SD_MODEL_ID=segmind/tiny-sd

# ------------------------------------------------------------
# OPTIONAL — Prompt Search (DiffusionDB dataset)
# ------------------------------------------------------------

# Turso auth token — only needed if using a remote Turso database
# for the prompt search feature. Leave empty to use the local prompts.db file.
# Get yours at: https://turso.tech
TURSO_AUTH_TOKEN=
